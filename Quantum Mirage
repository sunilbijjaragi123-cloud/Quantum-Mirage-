import os
import random
import hashlib

class QuantumMirage:
    def __init__(self):
        self.real_data_key = "REAL_VAULT"
        self.fake_data_key = "MIRAGE_VAULT"
        print("🌌 Quantum Mirage Initialized - Deception Layer Active")

    def generate_fake_data(self, original_data_length):
        """Generates believable but fake data for attacker"""
        fake_templates = [
            f"CONFIDENTIAL_FINANCE_REPORT_{random.randint(1000,9999)}.pdf",
            f"USER_CREDENTIALS_BACKUP_{hashlib.md5(os.urandom(8)).hexdigest()[:8]}",
            f"PRIVATE_KEY_BANK_ACCOUNT_XYZ_{random.randint(100000,999999)}"
        ]
        return random.choice(fake_templates) * 2

    def deception_encrypt(self, real_data: str, password: str):
        """Encrypts real data, but creates a trap for wrong passwords"""
        # Real encryption (simple hash for demo)
        real_hash = hashlib.sha256((real_data + password).encode()).hexdigest()
        
        # Deception Layer
        fake_data = self.generate_fake_data(len(real_data))
        print(f"[+] Real Data Secured in {self.real_data_key}")
        print(f"[+] Mirage Created in {self.fake_data_key} -> {fake_data[:30]}...")
        
        return {
            "real_hash": real_hash,
            "mirage_vault": fake_data,
            "status": "Deception Active"
        }

    def attempt_decrypt(self, encrypted_package, entered_password, correct_password):
        """What happens when attacker tries to decrypt"""
        if entered_password == correct_password:
            return "✅ ACCESS GRANTED: Real Data Unlocked"
        else:
            # Attacker thinks he succeeded!
            print("⚠️  Intrusion Detected! Serving Mirage...")
            return f"✅ DECRYPTED (FAKE): {encrypted_package['mirage_vault'][:100]}... [Attacker Thinks He Won]"

# Demo
if __name__ == "__main__":
    qm = QuantumMirage()
    secret = "My Real Bank Details: Account 12345"
    package = qm.deception_encrypt(secret, "my_strong_password_123")
    
    # Attacker with quantum computer tries brute force
    print("\n--- Attacker Attempt 1 (Wrong Password) ---")
    result = qm.attempt_decrypt(package, "wrong_password", "my_strong_password_123")
    print(result)

    print("\n--- Owner Attempt (Correct Password) ---")
